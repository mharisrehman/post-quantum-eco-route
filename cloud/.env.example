POSTGRES_DB=eco_route
POSTGRES_USER=eco_route
POSTGRES_PASSWORD=eco_route
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CLOUD_DB_DSN=postgresql://eco_route:eco_route@localhost:5432/eco_route

# Device / gateway authentication
# Comma-separated id=key pairs (or plain keys). The cloud API validates the X-Device-API-Key header against these values.
DEVICE_API_KEYS=bin-1=local-bin-1-key,bin-2=local-bin-2-key,bin-3=local-bin-3-key,gateway=gateway-service-key
REQUIRE_DEVICE_AUTH=true
